# Finish Line — environment
# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Both values are safe to expose to the browser:
# this is a single-user app with RLS deliberately disabled (see
# supabase/migrations/0001_init.sql).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. If set, GET /api/cron requires `Authorization: Bearer <this>`.
# Vercel Cron sends this automatically when CRON_SECRET is set on the project.
# Leave unset in local dev to trigger the recompute by hand.
CRON_SECRET=

# Required. Password for the /login gate (see middleware.ts). Anyone who
# knows it gets in; changing it invalidates every existing session cookie.
APP_PASSWORD=

# Required for the REST API (/api/v1/*, see API.md). Every request must send
# `Authorization: Bearer <API_KEY>`; if unset, the API rejects everything.
# Generate a strong url-safe key (32+ random bytes), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY=
