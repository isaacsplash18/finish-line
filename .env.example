# Finish Line — environment
# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Both values are safe to expose to the browser:
# this is a single-user app with RLS deliberately disabled (see
# supabase/migrations/0001_init.sql).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. If set, GET /api/cron requires `Authorization: Bearer <this>`.
# Vercel Cron sends this automatically when CRON_SECRET is set on the project.
# Leave unset in local dev to trigger the recompute by hand.
CRON_SECRET=

# Required. Password for the /login gate (see middleware.ts). Anyone who
# knows it gets in; changing it invalidates every existing session cookie.
APP_PASSWORD=

# Required for the REST API (/api/v1/*, see API.md). Every request must send
# `Authorization: Bearer <API_KEY>`; if unset, the API rejects everything.
# Generate a strong url-safe key (32+ random bytes), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY=

# v2 (SPEC-V2 §8). Separate, low-value bearer token for
# POST /api/v1/hooks/workout, which can ONLY add one to today's Workouts
# routine. Lets the public daily-app tick workouts without ever holding
# API_KEY (which is NOT accepted by the hook, and this token is accepted
# nowhere else). Unset ⇒ the hook rejects everything. Generate like API_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKOUT_HOOK_TOKEN=

# v2 (SPEC-V2 §6). Optional GitHub token for the commit-progress sync (nightly
# cron + POST /api/v1/github/sync). A fine-grained token with read-only
# "Contents" (or "Metadata") on the linked repos is enough. Unset ⇒
# unauthenticated: public repos only, 60 requests/hour, degrades silently.
GITHUB_TOKEN=
